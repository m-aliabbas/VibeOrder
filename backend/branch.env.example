# VibeOrder branch host settings. Copy to backend/branch.env on the branch PC (never commit the real file).
# Read by every manage.py command, including the services started at boot. Real environment variables win.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-50-random-characters
# Host names / IPs tablets use to reach this PC (through the TLS proxy), comma separated
DJANGO_ALLOWED_HOSTS=vibeorder.local,192.168.1.10,localhost,127.0.0.1

# --- Database (local PostgreSQL 17) ---
PGDATABASE=vibeorder
PGUSER=vibeorder
PGPASSWORD=change-me
PGHOST=127.0.0.1
PGPORT=5432
# Folder with pg_dump / pg_restore / createdb (Windows services have no useful PATH)
VIBEORDER_PG_BIN=C:\Program Files\PostgreSQL\17\bin

# --- This host ---
# Unique per machine; only the host named in Branch.writable_host may write (see take_over)
VIBEORDER_HOST_ID=b1-counter-pc
# waitress listens on loopback; Caddy terminates TLS on 443 and forwards here
VIBEORDER_LISTEN_HOST=127.0.0.1
VIBEORDER_LISTEN_PORT=8000
VIBEORDER_BEHIND_TLS_PROXY=1
VIBEORDER_TRUSTED_ORIGINS=https://vibeorder.local,https://192.168.1.10
# Staff app served from another origin (Flutter web) needs CORS; native tablet/Windows apps do not
VIBEORDER_CORS_ALL=0

# --- Backups (encrypted with Fernet; KEEP A COPY OF THIS KEY OFF THE MACHINE) ---
# Generate: manage.py branch_doctor prints a fresh key when none is set
VIBEORDER_BACKUP_KEY=
# Put this on a second disk or a synced folder if you can
VIBEORDER_BACKUP_DIR=D:\VibeOrderBackups
VIBEORDER_BACKUP_INTERVAL=15
VIBEORDER_BACKUP_KEEP=96
VIBEORDER_BACKUP_KEEP_DAILY=30
# Daily restore drill hour (local time), -1 to disable
VIBEORDER_DRILL_HOUR=4

# --- Cloud sync (owner portal + online orders) ---
# Comma separated branch codes this host syncs; empty = offline-only branch
VIBEORDER_SYNC_BRANCHES=B1
VIBEORDER_CLOUD_URL=https://cloud.example.pk
VIBEORDER_CLOUD_TOKEN=
